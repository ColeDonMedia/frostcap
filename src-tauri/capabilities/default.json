{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only: Frostcap commands, event listening, and the window controls the custom titlebar needs. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "allow-list-sources",
    "allow-list-cameras",
    "allow-pick-region",
    "allow-start-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-stop-recording",
    "allow-recording-state",
    "allow-load-project",
    "allow-save-project",
    "allow-list-recent-projects",
    "allow-recover-project",
    "allow-scrub-project",
    "allow-generate-auto-zoom",
    "allow-export-project",
    "allow-cancel-export",
    "allow-pick-project",
    "allow-pick-folder",
    "allow-pick-save-path",
    "allow-reveal-in-folder",
    "allow-hotkeys",
    "allow-set-hotkeys",
    "allow-default-output-dir"
  ]
}
