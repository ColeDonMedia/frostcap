# ---- Toolchain and build output -------------------------------------------
# Repo-local Rust toolchain, cargo home and npm cache (see env.ps1).
/.toolchain/
/target/
**/target/
# Rust
**/*.rs.bk
*.pdb

# ---- UI ----------------------------------------------------------------------
node_modules/
ui/dist/
ui/.vite/
ui/coverage/
*.tsbuildinfo
.eslintcache

# ---- Tauri ---------------------------------------------------------------------
# src-tauri/gen/schemas/ is regenerated by tauri-build on every build (ACL manifests
# and JSON schemas for capability files). Decision: not committed, to avoid churn
# and merge conflicts; editors get the schema after the first `cargo build`.
# If capability files ever need a committed schema for review, remove this line.
/src-tauri/gen/schemas/
# Installer / portable artefacts produced by release scripts
/dist/
/release/
*.msi
*.nsis.zip
*.sig

# ---- Recordings and project data (never commit user recordings) -------------
*.frostcap/
*.mp4
*.mkv
*.wav
!assets/**/*.mp4

# ---- Temp / partial files ----------------------------------------------------
*.partial
*.tmp
*.temp
*.bak
*.swp
*~
*.log
tmp/
temp/

# ---- Secrets -------------------------------------------------------------------
.env
.env.*
!.env.example
*.pfx
*.p12
*.snk

# ---- Editors and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.sublime-*
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
# Local Claude Code / agent settings
.claude/settings.local.json
