# Normalise text to LF in the repository and working tree on every OS.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Lockfiles and generated files: not diffed line by line in reviews.
Cargo.lock                 text eol=lf -diff linguist-generated
ui/package-lock.json       text eol=lf -diff linguist-generated
THIRD_PARTY_LICENSES.md    text eol=lf linguist-generated
src-tauri/gen/**           text eol=lf linguist-generated

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.bmp   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.mkv   binary
*.wav   binary
*.mp3   binary
*.zip   binary
*.7z    binary
*.exe   binary
*.dll   binary
*.pdb   binary
*.msi   binary
